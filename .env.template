# Credit Risk Platform Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Application Environment: "local" or "production"
# - local: Uses config/local.yaml (development settings)
# - production: Uses config/production.yaml (Cloudera CML settings)
APP_ENV=local

# =============================================================================
# API KEYS (Required)
# =============================================================================

# Claude API Key (for LLM features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# LOCAL DEVELOPMENT SETTINGS
# These are optional - defaults are set in config/local.yaml
# =============================================================================

# API_HOST=127.0.0.1
# API_PORT=8000

# Database (SQLite for local)
# DATABASE_URL=sqlite:///./data/credit_risk.db

# Redis (optional for local)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================

# MLflow Tracking URI
# - Local mode: Uses local directory (./mlruns)
# - Production mode: Uses Cloudera MLflow server
#
# For Cloudera ML, this is typically set to:
#   https://<workspace>.ml.<domain>/mlflow
# Or you can use a file path on the CML filesystem:
#   /home/cdsw/mlruns
#
# Leave commented for local development (uses config/local.yaml default)
# MLFLOW_TRACKING_URI=./mlruns

# Production MLflow Server (Cloudera)
# Uncomment and set when APP_ENV=production
# MLFLOW_TRACKING_URI=https://your-workspace.ml.cloudera.site/mlflow
# MLFLOW_TRACKING_USERNAME=your_username
# MLFLOW_TRACKING_PASSWORD=your_password
# MLFLOW_TRACKING_TOKEN=your_token

# MLflow Experiment Name (optional - defaults based on environment)
# MLFLOW_EXPERIMENT_NAME=credit_risk_custom

# ChromaDB
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# =============================================================================
# PRODUCTION / CLOUDERA SETTINGS
# Set these when deploying to Cloudera ML (APP_ENV=production)
# =============================================================================

# Model Endpoints (CML model serving URLs)
# PD_MODEL_ENDPOINT=https://your-cml-domain/api/v1/models/pd/predict
# LGD_MODEL_ENDPOINT=https://your-cml-domain/api/v1/models/lgd/predict
# DOCUMENT_ENDPOINT=https://your-cml-domain/api/v1/models/document/process
# RAG_ENDPOINT=https://your-cml-domain/api/v1/models/rag/query

# Production Database
# DATABASE_URL=postgresql://user:pass@host:5432/credit_risk

# Production Redis
# REDIS_URL=redis://redis-host:6379

# =============================================================================
# CML SPECIFIC (Set automatically by Cloudera ML)
# =============================================================================

# CDSW_PROJECT_URL=
# CDSW_PROJECT_OWNER=
# CDSW_ENGINE_ID=
# CML_DOMAIN=
