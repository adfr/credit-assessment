{
    "project": {
      "name": "Credit Risk Approval Platform",
      "description": "End-to-end credit risk assessment on Cloudera ML",
      "stack": {
        "backend": ["Python", "FastAPI", "LangGraph", "Redis"],
        "frontend": ["React", "Next.js", "React Flow", "TailwindCSS"],
        "ml": ["XGBoost", "scikit-learn", "MLflow"],
        "data": ["SQLite/Iceberg", "Chroma"]
      }
    },
    "phases": [
      {
        "id": 0,
        "name": "Setup",
        "description": "Project initialization and infrastructure",
        "tasks": [
          {
            "id": "0.1",
            "name": "Create directory structure",
            "type": "shell",
            "command": "mkdir -p 0_setup 1_data 2_features 3_models/configs 4_endpoints 5_backend/{api,agents/nodes,agents/tools,services,models,utils} 6_frontend/{app,components,lib,hooks,types} 7_monitoring 8_cde_jobs 9_deployment tests docs",
            "priority": "critical"
          },
          {
            "id": "0.2",
            "name": "Create requirements.txt",
            "type": "file",
            "path": "requirements.txt",
            "content_description": "Python dependencies: fastapi, uvicorn, langgraph, langchain, scikit-learn, xgboost, mlflow, chromadb, redis, faker, etc.",
            "priority": "critical"
          },
          {
            "id": "0.3",
            "name": "Create install_dependencies.py",
            "type": "file",
            "path": "0_setup/install_dependencies.py",
            "content_description": "Script to pip install requirements and setup Node.js",
            "priority": "critical"
          },
          {
            "id": "0.4",
            "name": "Create create_tables.py",
            "type": "file",
            "path": "0_setup/create_tables.py",
            "content_description": "Create SQLite tables: loan_history, payment_history, bureau_data, model_features, applications, predictions, workflow_state",
            "priority": "critical"
          },
          {
            "id": "0.5",
            "name": "Create setup_vector_store.py",
            "type": "file",
            "path": "0_setup/setup_vector_store.py",
