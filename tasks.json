            "priority": "high"
          },
          {
            "id": "0.6",
            "name": "Create load_policy_docs.py",
            "type": "file",
            "path": "0_setup/load_policy_docs.py",
            "content_description": "Create and embed credit policy documents into vector store",
            "priority": "high"
          }
        ]
      },
